{
  "name": "PlaidWebhookLog",
  "type": "object",
  "properties": {
    "webhook_type": {
      "type": "string"
    },
    "webhook_code": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "processed",
        "skipped",
        "error"
      ],
      "default": "processed"
    },
    "error_message": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    }
  },
  "required": [
    "webhook_type",
    "webhook_code"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}