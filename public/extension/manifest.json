{
  "manifest_version": 3,
  "name": "Nudigo Shopping Shield",
  "version": "2.0.0",
  "description": "Block shopping sites, get spending interventions, and ask your AI financial advisor before you buy.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://nudigofinance.base44.app/*",
    "https://base44.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://nudigofinance.base44.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["block.html", "intervention.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
